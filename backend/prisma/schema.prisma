generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  admin
}

enum AuthProvider {
  email
  google
  email_google
}

enum OtpPurpose {
  registration
  forgotPassword
}

enum AssessmentType {
  Quiz
  Assignment
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  REVIEWED
  REJECTED
  RESUBMISSION_REQUIRED
  OVERDUE
}

enum AssignmentFileType {
  PDF
  DOCX
  IMAGE
  ZIP
  OTHER
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  mobileNumber String?      @unique
  password     String?
  googleId     String?      @unique
  provider     AuthProvider @default(email)

  avatarUrl      String?
  avatarPublicId String?

  year    String?
  branch  String?
  section String?

  role UserRole @default(student)

  isEmailVerified    Boolean @default(false)
  isProfileCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens         RefreshToken[]
  userStats             UserStats?
  learningProgress      LearningProgress[]
  plannerTasks          PlannerTask[]
  notifications         Notification[]
  weakAreas             WeakArea[]
  dailyActivities       DailyActivity[]
  xpTransactions        XpTransaction[]
  userAchievements      UserAchievement[]
  bookmarks             UserBookmark[]
  readingProgress       UserReadingProgress[]
  createdAssignments    Assignment[]           @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[] @relation("StudentAssignmentSubmissions")
  reviewedAssignments   AssignmentSubmission[] @relation("AssignmentReviewer")
  settings              UserSettings?
  quizAttempts          QuizAttempt[]
  bookmarkedQuestions BookmarkedQuestion[]
}

model EmailOtp {
  id          String     @id @default(cuid())
  email       String
  otp         String
  purpose     OtpPurpose
  expiresAt   DateTime
  resendCount Int        @default(0)
  lastSentAt  DateTime   @default(now())
  isUsed      Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, purpose])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserStats {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  streakDays Int   @default(0)
  xpCurrent  Float @default(0)
  xpRequired Int   @default(100)
  level      Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningProgress {
  id             String   @id @default(cuid())
  moduleName     String
  progress       Int
  lastAccessedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleName]) // Ensures a user only has one progress record per module
  @@index([userId])
}

model PlannerTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([dueDate])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WeakArea {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  mistakeCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assessment {
  id      String         @id @default(cuid())
  title   String
  type    AssessmentType
  dueDate DateTime

  targetYear   String?
  targetBranch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
}

model DailyActivity {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  xpGained Float    @default(0)

  @@unique([userId, date])
  @@index([userId, date])
}

model XpTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source      String
  xpEarned    Float
  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
}

model Achievement {
  id          String @id @default(cuid())
  title       String
  description String
  xpReward    Float
  code        String @unique

  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  isViewed   Boolean  @default(false)
  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserSettings {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationsEnabled Boolean @default(true)
  reminderEnabled      Boolean @default(true)
  darkMode             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chapter {
  id          String  @id @default(cuid())
  title       String
  description String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
  questions   Question[]
  WeakArea    WeakArea[]

  @@index([subjectId])
}

model Note {
  id String @id @default(cuid())

  title       String
  description String?

  pdfUrl      String
  pdfPublicId String?

  downloads Int @default(0)
  views     Int @default(0)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks       UserBookmark[]
  readingProgress UserReadingProgress[]

  @@index([chapterId])
}

model UserBookmark {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, noteId])
  @@index([userId])
}

model UserReadingProgress {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  currentPage Int @default(1)
  totalPages  Int @default(0)

  lastOpenedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, noteId])
  @@index([userId])
}

model Assignment {
  id            String             @id @default(uuid())
  title         String
  description   String
  instructions  String?
  dueDate       DateTime
  totalMarks    Int                @default(0)
  assignmentUrl String
  fileType      AssignmentFileType
  isPublished   Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])

  submissions AssignmentSubmission[]

  @@index([chapterId])
  @@index([dueDate])
  @@index([isPublished])
}

model AssignmentSubmission {
  id               String           @id @default(uuid())
  submissionUrl    String
  submittedAt      DateTime         @default(now())
  status           AssignmentStatus @default(SUBMITTED)
  marksObtained    Int?
  feedback         String?
  reviewedAt       DateTime?
  isLateSubmission Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("AssignmentReviewer", fields: [reviewedById], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
}

model Question {
  id String @id @default(cuid())

  question String
  options  Json

  correctAnswer String
  explanation   String?

  difficulty QuizDifficulty

  marks Int @default(1)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quizAnswers QuizAnswer[]
  bookmarkedBy BookmarkedQuestion[]

  @@index([chapterId])
  @@index([difficulty])
}

model QuizAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  score      Int @default(0)
  totalMarks Int @default(0)

  totalQuestions Int

  correctAnswers Int @default(0)
  wrongAnswers   Int @default(0)

  difficulty QuizDifficulty

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  quizAnswers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model QuizAnswer {
  id String @id @default(cuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  selectedAnswer String

  isCorrect Boolean

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
}

model BookmarkedQuestion {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, questionId])
}

model DailyChallenge {
  id          String   @id @default(cuid())

  date        DateTime @unique

  questionIds String[]

  difficulty  Difficulty

  createdAt   DateTime @default(now())
}